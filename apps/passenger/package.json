{
  "name": "@heytaksi/passenger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --mode native && npm run cap:sync",
    "cap:add:android": "npx cap add android && node ../../scripts/patch-native-config.mjs passenger",
    "cap:add:ios": "npx cap add ios && node ../../scripts/patch-native-config.mjs passenger",
    "cap:sync": "npx cap sync && node ../../scripts/patch-native-config.mjs passenger",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@heytaksi/shared": "*",
    "@heytaksi/ui": "*",
    "lucide-react": "^1.33.0",
    "maplibre-gl": "^6.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/geolocation": "^7.1.0",
    "@capacitor/ios": "^7.4.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "@capacitor/cli": "^7.4.0"
  }
}
