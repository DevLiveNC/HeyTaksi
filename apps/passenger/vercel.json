{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && npm run build --workspace=@heytaksi/shared && npm run build --workspace=@heytaksi/passenger",
  "outputDirectory": "dist",
  "functions": { "api/index.js": { "maxDuration": 30 } },
  "env": {
    "VITE_MAP_PROVIDER": "osm",
    "VITE_MAP_STYLE_URL": "https://tiles.openfreemap.org/styles/liberty"
  },
  "build": {
    "env": {
      "VITE_MAP_PROVIDER": "osm",
      "VITE_MAP_STYLE_URL": "https://tiles.openfreemap.org/styles/liberty"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Permissions-Policy", "value": "geolocation=(self)" }]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?rest=/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
