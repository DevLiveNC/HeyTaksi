{
  "name": "heytaksi",
  "version": "0.1.0",
  "private": true,
  "description": "Hey Taksi ölçeklenebilir ride-hailing platformu monoreposu",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@heytaksi/api",
    "dev:api": "npm run dev --workspace=@heytaksi/api",
    "dev:passenger": "npm run dev --workspace=@heytaksi/passenger",
    "dev:driver": "npm run dev --workspace=@heytaksi/driver",
    "dev:admin": "npm run dev --workspace=@heytaksi/admin",
    "build": "npm run build --workspace=@heytaksi/shared && npm run build --workspaces --if-present",
    "typecheck": "npm run build --workspace=@heytaksi/shared && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint apps/*/src packages/*/src",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate --workspace=@heytaksi/api",
    "db:seed-admin": "npm run db:seed-admin --workspace=@heytaksi/api",
    "db:seed-demo": "npm run db:seed-demo --workspace=@heytaksi/api",
    "db:seed-all-demo": "npm run db:seed-all-demo --workspace=@heytaksi/api",
    "db:seed-fleet": "npm run db:seed-fleet --workspace=@heytaksi/api",
    "dev:simulate-fleet": "npm run dev:simulate-fleet --workspace=@heytaksi/api"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
