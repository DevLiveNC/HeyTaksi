{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npm run build --workspace=@heytaksi/shared && npm run build --workspace=@heytaksi/admin",
  "outputDirectory": "dist",
  "ignoreCommand": "node ../../scripts/vercel-ignore.mjs admin",
  "fluid": true,
  "regions": ["fra1"],
  "functions": { "api/index.js": { "maxDuration": 15 } },
  "env": {
    "VITE_MAP_PROVIDER": "osm",
    "VITE_MAP_STYLE_URL": "https://tiles.openfreemap.org/styles/liberty"
  },
  "build": {
    "env": {
      "VITE_MAP_PROVIDER": "osm",
      "VITE_MAP_STYLE_URL": "https://tiles.openfreemap.org/styles/liberty"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "geolocation=(self)" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?rest=/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
