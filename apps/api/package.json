{
  "name": "@heytaksi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "tsc -p ../../packages/shared/tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretypecheck": "tsc -p ../../packages/shared/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p api/tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:seed-admin": "tsx src/infrastructure/database/seed-admin.ts",
    "db:seed-demo": "tsx src/infrastructure/database/seed-demo.ts",
    "db:seed-all-demo": "tsx src/infrastructure/database/seed-all-demo.ts",
    "db:seed-fleet": "tsx src/infrastructure/database/seed-fleet.ts",
    "dev:simulate-fleet": "tsx src/infrastructure/database/simulate-fleet.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.0.0",
    "@heytaksi/shared": "*",
    "argon2": "^0.44.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.0.0",
    "pg": "^8.0.0",
    "pino": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
