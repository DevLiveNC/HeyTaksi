{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npm run build --workspace=@heytaksi/shared && npm run build --workspace=@heytaksi/api",
  "ignoreCommand": "node ../../scripts/vercel-ignore.mjs api",
  "fluid": true,
  "regions": ["fra1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "excludeFiles": "{**/*.test.ts,src/infrastructure/database/seed-*.ts,src/infrastructure/database/simulate-fleet.ts}"
    }
  },
  "env": {
    "MAP_PROVIDER": "osm",
    "GEOCODING_URL": "https://nominatim.openstreetmap.org",
    "ROUTING_URL": "https://router.project-osrm.org",
    "MAP_SERVICE_USER_AGENT": "HeyTaksi/0.1 support@heytaksi.app",
    "MAP_FALLBACK": "true"
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.ts" }]
}
