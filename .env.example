NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
API_PREFIX=/api/v1
DATABASE_URL=postgresql://heytaksi:heytaksi@localhost:5432/heytaksi
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-too-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
SESSION_TTL_DAYS=30
OTP_SECRET=change-me-otp-secret-with-at-least-32-characters
OTP_TTL_MINUTES=5
# Sadece yerel testte true yapılabilir; production'da kod SMS sağlayıcısından gönderilmelidir.
OTP_EXPOSE_CODE=false
# Production SMS gateway webhook'u: POST { phone, code, ttlSeconds }
# OTP_PROVIDER_WEBHOOK_URL=https://sms-provider.example/send
# OTP_PROVIDER_API_KEY=provider-secret
GEOCODING_URL=https://nominatim.openstreetmap.org
ROUTING_URL=https://router.project-osrm.org
MAP_SERVICE_USER_AGENT=HeyTaksi/0.1 support@heytaksi.app
# Sağlayıcı erişilemezse yaklaşık rota/adres üreten geliştirme modu; production'da false olmalı.
MAP_FALLBACK=true
# Harita: OSM/MapLibre varsayılanı API anahtarı gerektirmez (OpenFreeMap Liberty).
# Vercel dashboard'da VITE_MAP_PROVIDER=google kalmışsa OSM karoları hiç çizilmez.
MAP_PROVIDER=osm
VITE_MAP_PROVIDER=osm
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Google Maps (isteğe bağlı). Yalnızca gerçek Google haritası isteniyorsa:
# MAP_PROVIDER=google
# VITE_MAP_PROVIDER=google
# GOOGLE_MAPS_API_KEY=          # Directions + Geocoding (sunucu, IP kısıtlı)
# GOOGLE_MAPS_BROWSER_KEY=     # Maps JavaScript API (HTTP referrer kısıtlı)
# GOOGLE_MAPS_MAP_ID=
# VITE_GOOGLE_MAPS_API_KEY=     # tarayıcı; verilmezse GOOGLE_MAPS_BROWSER_KEY kullanılır
# VITE_GOOGLE_MAPS_MAP_ID=
# Yalnızca `npm run db:seed-admin` komutu için gereklidir.
ADMIN_EMAIL=admin@heytaksi.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_FIRST_NAME=Hey Taksi
ADMIN_LAST_NAME=Admin
# Yalnızca `npm run db:seed-demo` komutu için: doğrulanmış demo sürücü + yolcu ve geçmiş yolculuklar.
DEMO_DRIVER_EMAIL=driver@heytaksi.com
DEMO_DRIVER_PASSWORD=HeyTaksi2026
DEMO_PASSENGER_EMAIL=passenger@heytaksi.com
DEMO_PASSENGER_PASSWORD=HeyTaksi2026
# Yalnızca `npm run db:seed-all-demo` komutu için: tüm roller için demo hesaplar
# driver/passenger için yukarıdaki değişkenler yoksa aşağıdaki varsayılanlar kullanılır:
# driver.demo@heytaksi.com / DriverDemo2026! ve passenger.demo@heytaksi.com / PassengerDemo2026!
DEMO_ADMIN_EMAIL=admin.demo@heytaksi.com
DEMO_ADMIN_PASSWORD=AdminDemo2026!
DEMO_DISPATCHER_EMAIL=dispatcher.demo@heytaksi.com
DEMO_DISPATCHER_PASSWORD=DispatcherDemo2026!
DEMO_SUPPORT_EMAIL=support.demo@heytaksi.com
DEMO_SUPPORT_PASSWORD=SupportDemo2026!
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Canlı/preview dağıtımlarında frontend origin'lerini virgülle ekleyin.
# hey-taksi-*.vercel.app hostları API tarafında ayrıca otomatik kabul edilir.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://hey-taksi-admin.vercel.app
# Boş bırakılırsa uygulamalar aynı origin üzerinden (Vite proxy / Vercel /api proxy) API’ye erişir.
# VITE_API_URL=http://localhost:3000/api/v1
# VITE_WS_URL=ws://localhost:3000/ws
# Frontend Vercel projelerinde aynı-origin `/api` proxy'si için API hostu (path yok).
# Boş bırakılırsa production varsayılanı https://hey-taksi-api.vercel.app kullanılır.
# API_ORIGIN=https://hey-taksi-api.vercel.app

# --- Faz 6: gerçek zamanlı dispatch ---
# Demo filosu (`npm run db:seed-fleet`) ve hareket simülatörü (`npm run dev:simulate-fleet`) içindir.
DEMO_FLEET_PASSWORD=FleetDemo2026!
DEMO_FLEET_CENTER_LAT=35.1856
DEMO_FLEET_CENTER_LON=33.3823
# Simülatör teklif davranışı: accept | reject | ignore
SIMULATOR_OFFER_POLICY=accept
# Gerçek sürücü uygulamasına öncelik tanımak için beklenen saniye.
SIMULATOR_ACCEPT_DELAY=8
